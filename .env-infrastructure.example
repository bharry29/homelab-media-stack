# =============================================================================
# INFRASTRUCTURE STACK ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# This file contains environment variables for the INFRASTRUCTURE stack.
# Copy this file to .env-infrastructure and configure with your settings.
#
# Usage: docker-compose --env-file .env-infrastructure -f docker-compose-infrastructure.yml up -d
# =============================================================================

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# User and Group IDs (get with: id $USER)
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# =============================================================================
# PATHS CONFIGURATION
# =============================================================================

# Infrastructure stack configuration path
INFRASTRUCTURE_CONFIG_PATH=/volume1/docker/infrastructure

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Service Dashboard
HOMARR_PORT=7575

# System Monitoring
UPTIME_KUMA_PORT=3001

# =============================================================================
# WATCHTOWER CONFIGURATION
# =============================================================================

# Automatic updates configuration
WATCHTOWER_CLEANUP=true
WATCHTOWER_REMOVE_VOLUMES=false
WATCHTOWER_INCLUDE_STOPPED=true
WATCHTOWER_SCHEDULE=0 6 * * *
WATCHTOWER_LABEL_ENABLE=true
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_DEBUG=false

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Update PUID and PGID to match your system user
# 2. Set your timezone in TZ variable
# 3. Homarr will automatically discover all Docker containers
# 4. Configure Uptime Kuma to monitor services from all stacks
# 5. Watchtower will automatically update infrastructure stack containers
#
# =============================================================================

