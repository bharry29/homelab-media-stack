# =============================================================================
# WEBSITES STACK - Environment Configuration
# =============================================================================
# Copy this file to .env-websites and update with your values
# =============================================================================

# System Configuration
PUID=1026
PGID=100
TZ=America/Los_Angeles

# Directory Paths
# Update these paths to match your NAS setup
WEBSITES_CONFIG_PATH=/volume1/docker/websites
DATA_PATH=/volume1/data

# Watchtower Configuration
WATCHTOWER_CLEANUP=true
WATCHTOWER_REMOVE_VOLUMES=false
WATCHTOWER_INCLUDE_STOPPED=true
WATCHTOWER_SCHEDULE=0 6 * * *
WATCHTOWER_LABEL_ENABLE=true
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_DEBUG=false

# =============================================================================
# PLATFORM-SPECIFIC PATH EXAMPLES
# =============================================================================
# Synology: /volume1/docker/websites
# QNAP: /share/docker/websites
# Unraid: /mnt/user/docker/websites
# TrueNAS: /mnt/pool/docker/websites
# Linux: /opt/homelab/docker/websites
# Windows: C:\homelab\docker\websites
# =============================================================================

