# =============================================================================
# CREATARR STACK ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# This file contains environment variables for the CREATARR stack.
# Copy this file to .env-creatarr and configure with your settings.
#
# Usage: docker-compose --env-file .env-creatarr -f docker-compose-creatarr.yml up -d
# =============================================================================

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# User and Group IDs (get with: id $USER)
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# =============================================================================
# PATHS CONFIGURATION
# =============================================================================

# Base data path (shared with other stacks)
DATA_PATH=/volume1/data

# Creatarr stack configuration path
CREATARR_CONFIG_PATH=/volume1/docker/creatarr

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Gaming & ROM Management
RETROARCH_PORT=8081

# Music Production & Creative Audio
NOISEDASH_PORT=3002
SWING_MUSIC_PORT=1970

# Comics & Manga Management  
KOMGA_PORT=25600

# Audio Services
AUDIOBOOKSHELF_PORT=13378

# Books & Reading
CALIBRE_WEB_PORT=8083

# Family Life Management
MEALIE_PORT=9001

# Workflow Automation & Creative Tools
N8N_PORT=5678

# Note: UptimeKuma is now in SERVARR stack with Portainer

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Komga Configuration
KOMGA_ADMIN_USER=admin
KOMGA_ADMIN_PASSWORD=your_secure_password_here

# Mealie Configuration
MEALIE_ADMIN_EMAIL=admin@yourdomain.com
MEALIE_ADMIN_PASSWORD=your_secure_password_here
MEALIE_ALLOW_SIGNUP=true
MEALIE_BASE_URL=http://your-nas-ip:9001

# Mealie Database Configuration
MEALIE_DB_NAME=mealie
MEALIE_DB_USER=mealieuser
MEALIE_DB_PASSWORD=your_secure_db_password_here

# SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_NAME=Mealie
SMTP_AUTH_STRATEGY=TLS
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=

# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=your_secure_password_here
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_LOG_LEVEL=info

# n8n HTTPS/Domain Configuration (Choose one option)
# Option 1: Local setup (no domain)
# N8N_SECURE_COOKIE=false
# N8N_EDITOR_BASE_URL=

# Option 2: Domain with HTTPS (recommended for production)
# N8N_SECURE_COOKIE=true
# N8N_EDITOR_BASE_URL=https://your-domain.com
# N8N_WEBHOOK_URL=https://your-domain.com
# N8N_PROTOCOL=https
# N8N_HOST=your-domain.com

# n8n Security (Required for HTTPS/domain access, optional for HTTP/local)
# Generate with: openssl rand -base64 32
# Or use existing key from n8n config: {"encryptionKey": "your_key_here"}
N8N_ENCRYPTION_KEY=your_encryption_key_here

# n8n Performance & Security Configuration
DB_SQLITE_POOL_SIZE=10
N8N_RUNNERS_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# n8n Database Configuration
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=your_secure_db_password_here

# Note: Navidrome is now in STREAMARR stack

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Discord Webhook for notifications (optional)
DISCORD_WEBHOOK=

# Email configuration for notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Update PUID and PGID to match your system user
# 2. Set your timezone in TZ variable
# 3. Configure secure passwords for admin accounts
# 4. Set up Discord webhook for notifications (optional)
# 5. Configure email settings for notifications (optional)
#
# =============================================================================
