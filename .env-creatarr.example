# =============================================================================
# CREATARR STACK ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# This file contains environment variables for the CREATARR stack.
# Copy this file to .env-creatarr and configure with your settings.
#
# Usage: docker-compose --env-file .env-creatarr -f docker-compose-creatarr.yml up -d
# =============================================================================

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# User and Group IDs (get with: id $USER)
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# =============================================================================
# PATHS CONFIGURATION
# =============================================================================

# Base data path (shared with other stacks)
DATA_PATH=/volume1/data

# Creatarr stack configuration path
CREATARR_CONFIG_PATH=/volume1/docker/creatarr

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Gaming & ROM Management
RETROARCH_PORT=8081

# Music Production & Creative Audio
NOISEDASH_PORT=3002
SWING_MUSIC_PORT=1970

# Comics & Manga Management  
KOMGA_PORT=25600

# Audio Services
AUDIOBOOKSHELF_PORT=13378

# Books & Reading
CALIBRE_WEB_PORT=8083

# Note: n8n and Mealie moved to BUSINESS stack
# Note: Uptime Kuma and Homarr moved to INFRASTRUCTURE stack

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Komga Configuration
KOMGA_ADMIN_USER=admin
KOMGA_ADMIN_PASSWORD=your_secure_password_here

# Note: n8n and Mealie configuration moved to .env-business
# Note: Navidrome is in STREAMARR stack

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Discord Webhook for notifications (optional)
DISCORD_WEBHOOK=

# Email configuration for notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Update PUID and PGID to match your system user
# 2. Set your timezone in TZ variable
# 3. Configure secure passwords for admin accounts
# 4. Set up Discord webhook for notifications (optional)
# 5. Configure email settings for notifications (optional)
#
# =============================================================================
